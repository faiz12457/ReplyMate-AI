# ReplyMate AI — Mobile Environment Variables
# Copy this file to .env and fill in values as needed.
# Variables prefixed EXPO_PUBLIC_ are bundled into the app build (safe for URLs).
# NEVER put API keys here — they belong in backend/.env only.

# Optional: Override the backend API URL (e.g. your deployed Railway URL).
# Leave empty to use automatic resolution:
#   - Android Emulator → http://10.0.2.2:3001
#   - Physical device  → auto-detected via LAN IP from Expo DevTools
#   - Production       → set this to your Railway / Render URL
EXPO_PUBLIC_API_URL=
