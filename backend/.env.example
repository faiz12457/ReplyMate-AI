# Server Configuration
PORT=3001
NODE_ENV=development

# Google Gemini API Key (keep this secret on the backend only — NEVER put in mobile code)
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model (defaults to gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: upstream AI request timeout in milliseconds (defaults to 20000)
AI_TIMEOUT_MS=20000

# Optional: comma-separated allowed CORS origins for web testing (leave empty in local dev)
ALLOWED_ORIGINS=
