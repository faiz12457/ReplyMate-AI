# Server Configuration
PORT=3001
NODE_ENV=development

# OpenAI API Key (keep this secret on the backend only — NEVER put in mobile code)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the default model (defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Optional: comma-separated allowed CORS origins for web testing (leave empty in local dev)
ALLOWED_ORIGINS=
